rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isAuth() && request.auth.uid == ownerId;
    }

    function isAdmin() {
      return isAuth() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users — read/write own document only
    match /users/{userId} {
      allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuth() && request.auth.uid == userId;
      allow update: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Dogs — owner or shared users
    match /dogs/{dogId} {
      allow read: if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        request.auth.uid in resource.data.sharedWith ||
        isAdmin()
      );
      allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
    }

    // Vaccination Types — read for all auth, write for admin or own custom
    match /vaccinationTypes/{typeId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAuth() && (
        resource.data.createdBy == request.auth.uid ||
        isAdmin()
      );
    }

    // Vaccination Records — owner only
    match /vaccinationRecords/{recordId} {
      allow read: if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
    }

    // Health Records — owner only
    match /healthRecords/{recordId} {
      allow read: if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
    }

    // Reminders — owner only, Cloud Functions can write via Admin SDK
    match /reminders/{reminderId} {
      allow read: if isAuth() && resource.data.ownerId == request.auth.uid;
      allow update: if isAuth() && resource.data.ownerId == request.auth.uid;
      // create/delete via Cloud Functions Admin SDK only
    }

    // Admin Logs — read for admin, write via Cloud Functions
    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
    }

    // Feedback — anyone can create, users can read their own, admin can read/update/delete
    match /feedback/{feedbackId} {
      allow create: if isAuth();
      allow read: if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Notifications — admin can read/write, users can read
    match /notifications/{notificationId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Share Tokens — owner creates/deletes, public can read (no auth needed for share links)
    match /shareTokens/{token} {
      allow read: if true;                    // public — token is the secret
      allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isAuth() && resource.data.ownerId == request.auth.uid;
    }

    // Daily Journals — owner only (composite ID: ownerId_dogId_date)
    match /dailyJournals/{journalId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuth() && resource.data.ownerId == request.auth.uid;
      allow delete: if isAuth() && resource.data.ownerId == request.auth.uid;
    }

    // Walk Logs — owner only
    match /walkLogs/{walkId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuth() && resource.data.ownerId == request.auth.uid;
      allow delete: if isAuth() && resource.data.ownerId == request.auth.uid;
    }

    // Community Posts — all auth users can read, author can create/edit/delete, anyone can like
    match /communityPosts/{postId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy', 'commentCount'])
      );
      allow delete: if isAuth() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // Community Comments — all auth can read/create, author can delete
    match /communityComments/{commentId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.authorId == request.auth.uid;
      allow delete: if isAuth() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // Reports — users create, admin reads
    match /reports/{reportId} {
      allow create: if isAuth() && request.resource.data.reporterId == request.auth.uid;
      allow read: if isAdmin();
      allow update: if isAdmin();
    }

    // Training Progress — owner can CRUD, auth can read (for leaderboards later)
    match /trainingProgress/{progressId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuth() && resource.data.ownerId == request.auth.uid;
      allow delete: if isAuth() && resource.data.ownerId == request.auth.uid;
    }

    // Challenge Entries — owner can CRUD
    match /challengeEntries/{entryId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuth() && resource.data.ownerId == request.auth.uid;
      allow delete: if isAuth() && resource.data.ownerId == request.auth.uid;
    }

    // Expenses — owner only
    match /expenses/{expenseId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuth() && resource.data.ownerId == request.auth.uid;
      allow delete: if isAuth() && resource.data.ownerId == request.auth.uid;
    }

    // Walk Routes (GPS) — owner only
    match /walkRoutes/{routeId} {
      allow read: if isAuth() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isAuth() && resource.data.ownerId == request.auth.uid;
    }

    // Playdate Requests — sender/receiver can read, sender creates, receiver updates status
    match /playdateRequests/{requestId} {
      allow read: if isAuth() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
      allow create: if isAuth() && request.resource.data.fromUserId == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.toUserId == request.auth.uid ||
        resource.data.fromUserId == request.auth.uid
      );
    }

    // Chat Threads — participants only
    match /chatThreads/{threadId} {
      allow read: if isAuth() && request.auth.uid in resource.data.participants;
      allow create: if isAuth() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuth() && request.auth.uid in resource.data.participants;
    }

    // Chat Messages — participants of the thread
    match /chatMessages/{messageId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.senderId == request.auth.uid;
    }

    // App Config (feature flags) — all auth can read, admin can write
    match /appConfig/{configId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Analytics Events (batched) — any auth user can create, admin reads
    match /analytics_batches/{batchId} {
      allow create: if isAuth();
      allow read: if isAdmin();
    }

    // Analytics Sessions — auth creates/updates own, admin reads all
    match /analytics_sessions/{sessionId} {
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
    }
  }
}
